# ─────────────────────────────────────────────────────────────
# Portfolio environment variables
# Copy to .env (or .env.local) and fill in. Every value is OPTIONAL:
# the site runs on the local data in /data when they are empty.
# ─────────────────────────────────────────────────────────────

# ── Hygraph (headless CMS) ───────────────────────────────────
# Powers: Contact form, Guestbook, and (optionally) home-page background images.
# Hygraph → Project settings → Endpoints → "High Performance Content API"
NEXT_PUBLIC_HYGRAPH_URL=
# Hygraph → Project settings → Permanent Auth Tokens.
# Needs Read on Profile/GuestBook and Create+Publish on Contact/GuestBook.
# NOTE: NEXT_PUBLIC_ means it is visible in the browser — give it minimal permissions.
NEXT_PUBLIC_HYGRAPH_AUTH_TOKEN=

# ── Google Analytics 4 (tracking tag) ────────────────────────
# GA4 → Admin → Data streams → your web stream → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ── Google Analytics Data API (page-view counter on Statistics page) ──
# Server-only secrets (no NEXT_PUBLIC_ prefix, never sent to the browser).
# GA4 → Admin → Property settings → Property ID (numbers only)
GA_PROPERTY_ID=
# Google Cloud service account with "Google Analytics Data API" enabled,
# added as a Viewer on the GA4 property. Copy from its JSON key file.
GA_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences, e.g.
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GA_PRIVATE_KEY=
